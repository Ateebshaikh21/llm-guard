# ── Database (local PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://llmguard:llmguard123@localhost:5432/llmguard

# ── Redis (local) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_any_random_32char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_BACKEND=openai

# Ollama (local LLM — set LLM_BACKEND=ollama to use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Firewall ──────────────────────────────────────────────────────────
ML_BLOCK_THRESHOLD=0.75
MAX_PROMPT_LENGTH=4000
ML_INFERENCE_URL=http://localhost:8001

# ── Alerts (optional) ─────────────────────────────────────────────────
ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
