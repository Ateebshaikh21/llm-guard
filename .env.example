# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://llmguard:llmguard123@localhost:5432/llmguard

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The default value will be REJECTED in production (ENVIRONMENT=production).
JWT_SECRET_KEY=change_this_to_a_random_64char_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_BACKEND=openai

# Ollama (local LLM — set LLM_BACKEND=ollama to use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# TLS — set to true ONLY for local dev with an intercepting SSL proxy.
# BLOCKED in production. Default: false.
ALLOW_INSECURE_TLS=false

# Optional: path to custom CA bundle for self-signed Ollama certs
# LLM_CA_BUNDLE=/etc/ssl/certs/my-ca.pem

# ── Firewall / ML ─────────────────────────────────────────────────────
ML_BLOCK_THRESHOLD=0.75
MAX_PROMPT_LENGTH=4000
ML_INFERENCE_URL=http://localhost:8001

# ── DLP ───────────────────────────────────────────────────────────────
DLP_ENABLED=true
DLP_LANGUAGE=en
DLP_CONFIDENCE_THRESHOLD=0.75
DLP_REDIS_TTL=3600
DLP_PLACEHOLDER_FORMAT=uuid

# ── Rate Limiting ──────────────────────────────────────────────────────
INSPECT_RATE_LIMIT=60     # requests per window per user
INSPECT_RATE_WINDOW=60    # window size in seconds

# ── Alerts (optional) ─────────────────────────────────────────────────
ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
